.rooster {
  position: relative;
  display: inline-block;
  overflow: visible;
}
.stage {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 200rpx;
  height: 200rpx;
  margin: -100rpx 0 0 -100rpx;
  transform-origin: center center;
}
.stage > view { position: absolute; }

/* ---- tail feathers ---- */
.tail { left: 0; top: 0; width: 200rpx; height: 200rpx; transform-origin: 38% 62%; }
.feather { position: absolute; border-radius: 50%; transform-origin: right center; }
.f1 { left: 4rpx; top: 58rpx; width: 70rpx; height: 24rpx; background: linear-gradient(90deg, #C9661F, #F0A030); transform: rotate(-30deg); }
.f2 { left: 0rpx; top: 82rpx; width: 78rpx; height: 26rpx; background: linear-gradient(90deg, #D8342A, #F08030); transform: rotate(-9deg); }
.f3 { left: 8rpx; top: 106rpx; width: 66rpx; height: 22rpx; background: linear-gradient(90deg, #E8761E, #FFB84A); transform: rotate(10deg); }

/* ---- legs ---- */
.legs { left: 0; top: 0; width: 200rpx; height: 200rpx; }
.leg { position: absolute; width: 9rpx; height: 24rpx; background: #E8891A; border-radius: 5rpx; }
.leg::after {
  content: '';
  position: absolute;
  left: -10rpx;
  bottom: -2rpx;
  width: 28rpx;
  height: 7rpx;
  background: #E8891A;
  border-radius: 4rpx;
  box-shadow: 0 7rpx 0 -1rpx #E8891A;
}
.l1 { left: 88rpx; top: 176rpx; }
.l2 { left: 120rpx; top: 176rpx; }

/* ---- body ---- */
.body {
  left: 26rpx; top: 64rpx; width: 138rpx; height: 118rpx;
  border-radius: 50% 50% 48% 48% / 54% 54% 46% 46%;
  background: linear-gradient(155deg, #FFD05A 0%, #FFAB33 48%, #EE7C1E 100%);
  box-shadow: inset -10rpx -12rpx 0 rgba(160, 66, 18, 0.14),
              inset 6rpx 8rpx 0 rgba(255, 236, 160, 0.4);
  transform-origin: center bottom;
}
.belly {
  left: 34rpx; top: 40rpx; width: 88rpx; height: 58rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at 40% 30%, rgba(255, 236, 170, 0.75), rgba(255, 205, 110, 0) 70%);
}
.wing {
  left: 22rpx; top: 34rpx; width: 78rpx; height: 58rpx;
  border-radius: 50% 50% 46% 54%;
  background: linear-gradient(140deg, #FFC24A, #F0922A);
  border: 2rpx solid #CE6C22;
  transform: rotate(-14deg);
  box-shadow: inset 4rpx 4rpx 0 rgba(255, 232, 160, 0.5);
}
.wing-line { position: absolute; border-bottom: 3rpx solid #C96A22; border-radius: 0 0 50% 50%; }
.wla { left: 12rpx; top: 14rpx; width: 52rpx; height: 26rpx; transform: rotate(-10deg); }
.wlb { left: 16rpx; top: 24rpx; width: 40rpx; height: 20rpx; transform: rotate(-6deg); }

/* ---- head ---- */
.head { left: 84rpx; top: 34rpx; width: 92rpx; height: 92rpx; transform-origin: 22% 88%; }
.head > view { position: absolute; }
.skull {
  left: 0; top: 0; width: 92rpx; height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #FFD45E 0%, #FFAE35 55%, #F28A22 100%);
  box-shadow: inset -6rpx -8rpx 0 rgba(160, 66, 18, 0.12),
              inset 5rpx 6rpx 0 rgba(255, 238, 170, 0.45);
}
.comb { background: #D8342A; border-radius: 52% 52% 45% 45%; box-shadow: inset -3rpx -4rpx 0 rgba(140, 30, 20, 0.25); }
.c1 { left: 12rpx; top: -12rpx; width: 26rpx; height: 30rpx; transform: rotate(-10deg); }
.c2 { left: 34rpx; top: -22rpx; width: 30rpx; height: 38rpx; }
.c3 { left: 58rpx; top: -12rpx; width: 26rpx; height: 30rpx; transform: rotate(10deg); }
.eye {
  left: 60rpx; top: 38rpx; width: 18rpx; height: 20rpx;
  background: #FFFDF7;
  border: 2rpx solid #A0522D;
  border-radius: 50%;
}
.pupil { left: 5rpx; top: 3rpx; width: 10rpx; height: 13rpx; background: #3A2416; border-radius: 50%; }
.pupil::after { content: ''; position: absolute; left: 2rpx; top: 2rpx; width: 4rpx; height: 4rpx; background: #FFF; border-radius: 50%; }
.blush { left: 50rpx; top: 60rpx; width: 28rpx; height: 17rpx; background: rgba(244, 116, 74, 0.5); border-radius: 50%; }
.beak-top {
  left: 84rpx; top: 44rpx; width: 0; height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 28rpx solid #FFC02E;
  transform-origin: left center;
}
.beak-bottom {
  left: 84rpx; top: 58rpx; width: 0; height: 0;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  border-left: 26rpx solid #F0971A;
  transform-origin: left center;
}
.wattle { left: 78rpx; top: 74rpx; width: 18rpx; height: 24rpx; background: #D8342A; border-radius: 50%; box-shadow: inset -3rpx -3rpx 0 rgba(140, 30, 20, 0.25); }

/* ---- crow sound rings ---- */
.ring {
  left: 148rpx; top: 20rpx; width: 56rpx; height: 56rpx;
  border: 4rpx solid rgba(255, 196, 74, 0.95);
  border-radius: 50%;
  opacity: 0;
}
/* sleep zzz */
.zzz { font-size: 32rpx; font-weight: 800; color: #A0522D; opacity: 0; }
.z1 { left: 156rpx; top: 0rpx; }
.z2 { left: 178rpx; top: -16rpx; font-size: 24rpx; }
/* happy sparks */
.spark { width: 14rpx; height: 14rpx; background: #FFD34D; transform: rotate(45deg); opacity: 0; border-radius: 2rpx; }
.s1 { left: 16rpx; top: 26rpx; }
.s2 { left: 172rpx; top: 122rpx; }

/* ---- moods ---- */
.mood-idle .body { animation: rr-breathe 3.2s ease-in-out infinite; }
.mood-idle .head { animation: rr-headbob 3.2s ease-in-out infinite; }
.mood-idle .tail { animation: rr-sway 4s ease-in-out infinite; }

.mood-crow .head { animation: rr-crowtilt 0.9s ease-in-out infinite; }
.mood-crow .beak-top { transform: rotate(-22deg); }
.mood-crow .beak-bottom { transform: rotate(26deg); }
.mood-crow .comb { animation: rr-comb 0.45s ease-in-out infinite; }
.mood-crow .body { animation: rr-breathe 0.9s ease-in-out infinite; }
.mood-crow .ring { animation: rr-ring 1.1s ease-out infinite; }
.mood-crow .r2 { animation-delay: 0.35s; }
.mood-crow .r3 { animation-delay: 0.7s; }

.mood-happy .body, .mood-happy .head, .mood-happy .tail { animation: rr-jump 0.6s ease-in-out infinite; }
.mood-happy .eye { height: 6rpx; top: 46rpx; border-radius: 6rpx; }
.mood-happy .pupil, .mood-happy .pupil::after { display: none; }
.mood-happy .spark { animation: rr-spark 0.7s ease-in-out infinite alternate; }
.mood-happy .s2 { animation-delay: 0.3s; }

.mood-sleep .body { animation: rr-breathe 4.6s ease-in-out infinite; }
.mood-sleep .head { transform: rotate(12deg); }
.mood-sleep .eye { height: 5rpx; top: 48rpx; border-radius: 5rpx; }
.mood-sleep .pupil, .mood-sleep .pupil::after { display: none; }
.mood-sleep .zzz { animation: rr-zfloat 2.4s ease-in-out infinite; }
.mood-sleep .z2 { animation-delay: 1.2s; }

@keyframes rr-breathe {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(1.035); }
}
@keyframes rr-headbob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(4rpx); }
}
@keyframes rr-sway {
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(4deg); }
}
@keyframes rr-crowtilt {
  0%, 100% { transform: rotate(0deg); }
  45% { transform: rotate(-18deg); }
  70% { transform: rotate(-14deg); }
}
@keyframes rr-comb {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3rpx); }
}
@keyframes rr-ring {
  0% { opacity: 0.9; transform: scale(0.4); }
  100% { opacity: 0; transform: scale(2.1); }
}
@keyframes rr-jump {
  0%, 100% { transform: translateY(0); }
  40% { transform: translateY(-12rpx); }
}
@keyframes rr-spark {
  from { opacity: 0.2; transform: rotate(45deg) scale(0.7); }
  to { opacity: 1; transform: rotate(45deg) scale(1.25); }
}
@keyframes rr-zfloat {
  0% { opacity: 0; transform: translateY(6rpx); }
  35% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-22rpx); }
}
