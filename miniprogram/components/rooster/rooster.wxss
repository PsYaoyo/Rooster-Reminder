.rooster {
  position: relative;
  display: inline-block;
  overflow: visible;
}
.stage {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 200rpx;
  height: 200rpx;
  margin: -100rpx 0 0 -100rpx;
  transform-origin: center center;
}
.stage > view { position: absolute; }

/* tail feathers */
.tail { left: 0; top: 0; width: 200rpx; height: 200rpx; transform-origin: 40% 60%; }
.feather { position: absolute; border-radius: 50%; transform-origin: right center; }
.f1 { left: 2rpx; top: 60rpx; width: 76rpx; height: 26rpx; background: #7A2450; transform: rotate(-30deg); }
.f2 { left: 0rpx; top: 84rpx; width: 80rpx; height: 26rpx; background: #E8442E; transform: rotate(-10deg); }
.f3 { left: 6rpx; top: 108rpx; width: 70rpx; height: 24rpx; background: #FF9E1B; transform: rotate(8deg); }

/* legs */
.legs { left: 0; top: 0; width: 200rpx; height: 200rpx; }
.leg { position: absolute; width: 8rpx; height: 26rpx; background: #B45309; border-radius: 4rpx; }
.leg::after {
  content: '';
  position: absolute;
  left: -6rpx;
  bottom: 0;
  width: 22rpx;
  height: 6rpx;
  background: #B45309;
  border-radius: 3rpx;
}
.l1 { left: 82rpx; top: 172rpx; }
.l2 { left: 110rpx; top: 172rpx; }

/* body & wing */
.body {
  left: 40rpx; top: 82rpx; width: 112rpx; height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB020 0%, #E8442E 100%);
  transform-origin: center bottom;
  box-shadow: inset -8rpx -10rpx 0 rgba(122, 36, 80, 0.18);
}
.wing {
  left: 62rpx; top: 108rpx; width: 56rpx; height: 42rpx;
  border-radius: 50%;
  background: #C2402A;
  transform: rotate(-18deg);
  box-shadow: inset 4rpx 4rpx 0 rgba(255, 211, 77, 0.35);
}

/* head group */
.head { left: 104rpx; top: 34rpx; width: 80rpx; height: 80rpx; transform-origin: 22% 88%; }
.head > view { position: absolute; }
.skull {
  left: 8rpx; top: 12rpx; width: 62rpx; height: 62rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD34D 0%, #FF9E1B 100%);
}
.comb { background: #D92D20; border-radius: 50%; }
.c1 { left: 10rpx; top: -6rpx; width: 20rpx; height: 26rpx; }
.c2 { left: 27rpx; top: -13rpx; width: 22rpx; height: 32rpx; }
.c3 { left: 45rpx; top: -6rpx; width: 20rpx; height: 26rpx; }
.eye { left: 40rpx; top: 32rpx; width: 11rpx; height: 11rpx; background: #221A10; border-radius: 50%; }
.beak-top {
  left: 66rpx; top: 34rpx; width: 0; height: 0;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  border-left: 26rpx solid #FFB020;
  transform-origin: left center;
}
.beak-bottom {
  left: 66rpx; top: 43rpx; width: 0; height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 22rpx solid #E8890C;
  transform-origin: left center;
}
.wattle { left: 60rpx; top: 54rpx; width: 14rpx; height: 20rpx; background: #D92D20; border-radius: 50%; }

/* crow sound rings */
.ring {
  left: 150rpx; top: 16rpx; width: 52rpx; height: 52rpx;
  border: 4rpx solid rgba(255, 211, 77, 0.9);
  border-radius: 50%;
  opacity: 0;
}
/* sleep zzz */
.zzz { font-size: 30rpx; font-weight: 800; color: #7A2450; opacity: 0; }
.z1 { left: 152rpx; top: 4rpx; }
.z2 { left: 172rpx; top: -12rpx; font-size: 22rpx; }
/* happy sparks */
.spark { width: 12rpx; height: 12rpx; background: #FFD34D; transform: rotate(45deg); opacity: 0; }
.s1 { left: 18rpx; top: 28rpx; }
.s2 { left: 172rpx; top: 118rpx; }

/* ---- moods ---- */
.mood-idle .body { animation: rr-breathe 3.2s ease-in-out infinite; }
.mood-idle .head { animation: rr-headbob 3.2s ease-in-out infinite; }
.mood-idle .tail { animation: rr-sway 4s ease-in-out infinite; }

.mood-crow .head { animation: rr-crowtilt 0.9s ease-in-out infinite; }
.mood-crow .beak-top { transform: rotate(-16deg); }
.mood-crow .beak-bottom { transform: rotate(20deg); }
.mood-crow .comb { animation: rr-comb 0.45s ease-in-out infinite; }
.mood-crow .body { animation: rr-breathe 0.9s ease-in-out infinite; }
.mood-crow .ring { animation: rr-ring 1.1s ease-out infinite; }
.mood-crow .r2 { animation-delay: 0.35s; }
.mood-crow .r3 { animation-delay: 0.7s; }

.mood-happy .body, .mood-happy .head, .mood-happy .tail { animation: rr-jump 0.6s ease-in-out infinite; }
.mood-happy .eye { height: 5rpx; border-radius: 4rpx; transform: translateY(4rpx); }
.mood-happy .spark { animation: rr-spark 0.7s ease-in-out infinite alternate; }
.mood-happy .s2 { animation-delay: 0.3s; }

.mood-sleep .body { animation: rr-breathe 4.6s ease-in-out infinite; }
.mood-sleep .head { transform: rotate(10deg); }
.mood-sleep .eye { height: 4rpx; border-radius: 4rpx; transform: translateY(5rpx); }
.mood-sleep .zzz { animation: rr-zfloat 2.4s ease-in-out infinite; }
.mood-sleep .z2 { animation-delay: 1.2s; }

@keyframes rr-breathe {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(1.035); }
}
@keyframes rr-headbob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(4rpx); }
}
@keyframes rr-sway {
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(4deg); }
}
@keyframes rr-crowtilt {
  0%, 100% { transform: rotate(0deg); }
  45% { transform: rotate(-18deg); }
  70% { transform: rotate(-14deg); }
}
@keyframes rr-comb {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3rpx); }
}
@keyframes rr-ring {
  0% { opacity: 0.9; transform: scale(0.4); }
  100% { opacity: 0; transform: scale(2.1); }
}
@keyframes rr-jump {
  0%, 100% { transform: translateY(0); }
  40% { transform: translateY(-12rpx); }
}
@keyframes rr-spark {
  from { opacity: 0.2; transform: rotate(45deg) scale(0.7); }
  to { opacity: 1; transform: rotate(45deg) scale(1.25); }
}
@keyframes rr-zfloat {
  0% { opacity: 0; transform: translateY(6rpx); }
  35% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-22rpx); }
}