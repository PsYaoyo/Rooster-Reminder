.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: stretch;
  background: #FFFDF7;
  border-top: 2rpx solid #F0E2CC;
  box-shadow: 0 -6rpx 24rpx rgba(43, 27, 78, 0.08);
  z-index: 90;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: #6B5D4A;
}
.tab.on { color: #E8442E; font-weight: 700; }
.ic { position: relative; width: 40rpx; height: 40rpx; }
.ic-bell {
  width: 32rpx;
  height: 30rpx;
  margin: 0 auto;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 16rpx 16rpx 4rpx 4rpx;
}
.ic-bell::after {
  content: '';
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  bottom: -4rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
}
.clapper {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  background: currentColor;
  border-radius: 50%;
}
.ic-person::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}
.ic-person::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 30rpx;
  height: 16rpx;
  margin-left: -15rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}
.create {
  flex: 1.1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 6rpx;
}
.create-disc {
  width: 108rpx;
  height: 108rpx;
  margin-top: -56rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #FFD34D 0%, #FF9E1B 45%, #E8442E 100%);
  box-shadow: 0 8rpx 24rpx rgba(232, 68, 46, 0.4), inset 0 -6rpx 0 rgba(122, 36, 80, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #FFFDF7;
}
.create-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #E8442E;
  margin-top: 2rpx;
}